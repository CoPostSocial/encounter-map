  const c=TC[t]||'#A8A77A', [r,g,b]=rgb(c), k=tcCount(t);
  return `<div class="tchero" style="background:linear-gradient(120deg,rgb(${r},${g},${b}),
    rgba(${r},${g},${b},.66));color:${inkOn(c)}">
    <div><div class="tcname">${esc(t)}</div>
    <div class="tcmeta">${k.mons} Pokémon · ${k.wild} of them catchable in the wild ·
      ${k.mv} damaging moves</div></div></div>`;
}
function tcGrid(){
  const T=TCH.names;
  const hcls=t=>tcSel?(tcSel===t?' axis':' dim'):'';
  const head=T.map(d=>`<th data-ty="${d}" class="${hcls(d).trim()}"><button data-tcty="${d}"
    style="${tcStyle(d)}" title="${d}">${tcAbbr(d)}</button></th>`).join('');
  const body=T.map(a=>`<tr><th data-ty="${a}" class="${hcls(a).trim()}"><button data-tcty="${a}"
    style="${tcStyle(a)}">${esc(a)}</button></th>${T.map(d=>{
      const m=tcRaw(a,d);
      const on=!tcSel||tcSel===a||tcSel===d;
      return `<td class="v${m}${on?(tcSel?' cross':''):' dim'}" data-a="${a}" data-d="${d}"
        data-m="${m}">${tcGlyph(m)}</td>`}).join('')}</tr>`).join('');
  return `<div class="tcwrap"><table class="tcgrid" id="tcgrid">
    <thead><tr><th class="cnr">atk ↓<br>def →</th>${head}</tr></thead>
    <tbody>${body}</tbody></table></div>`;
}
// Picking a type in list mode narrows to that one card rather than leaving you
// to scroll eighteen of them looking for it.
function tcList(){
  const list=tcSel?[tcSel]:TCH.names;
  return `<div class="mons" style="gap:14px">${list.map(t=>
    `<div>${tcHero(t)}${tcPanels(t)}</div>`).join('')}</div>`;
}
function tcReadDefault(){
  if(tcView!=='grid') return tcSel
    ? `Showing <b>${esc(tcSel)}</b> on its own. Pick it again to see all eighteen.`
    : 'Every type in full. Pick one above to see just that card.';
  return tcSel
    ? `Showing <b>${esc(tcSel)}</b> — its row is what it hits, its column is what hits it.`
    : 'Hover or tap a square to read the matchup.';
}
function renderTypeChart(){
  const box=document.getElementById('tcbox');
  if(!box) return;
  box.innerHTML=`<div class="ghd"><h2>Every type matchup</h2>
      <p class="mut" style="margin-top:8px;font-size:14px;max-width:72ch">Unbound uses the Gen VI chart, not
      Gen III's — Fairy exists, Steel no longer resists Ghost or Dark, and Dragon does nothing to Fairy.
      Attacking type reads down the left, defending across the top. Tap any square to hold it, or pick a
      type to pull out everything it does and everything done to it.</p></div>
    <div class="gsec">
      <div class="tcbar">
        <div class="tcseg">
          <button data-tcview="grid" aria-pressed="${tcView==='grid'}">Grid</button>
          <button data-tcview="list" aria-pressed="${tcView==='list'}">By type</button>
        </div>
        <div class="tcread" id="tcread">${tcReadDefault()}</div>
      </div>
      <div class="tcpick">${TCH.names.map(t=>`<button data-tcty="${t}" style="${tcStyle(t)}"
        class="${tcSel===t?'on':''}">${esc(t)}</button>`).join('')}${
        tcSel?`<button class="tcclear" data-tcclear="1">Clear</button>`:''}</div>
      ${tcSel&&tcView==='grid'?tcHero(tcSel)+tcPanels(tcSel):''}
      ${tcView==='grid'?tcGrid():tcList()}
      ${tcView==='grid'?`<div class="tclegend">
        <span><i style="background:linear-gradient(160deg,#3ad07a,#12a054)"></i>×2 super effective</span>
        <span><i style="background:linear-gradient(160deg,#ff9a70,#e04f37)"></i>×½ not very effective</span>
        <span><i style="background:linear-gradient(160deg,#525e7d,#1e2536)"></i>×0 no effect</span>
        <span><i style="background:var(--s3)"></i>×1 normal</span></div>`:''}
    </div>`;
  wireTypeChart();
}
function wireTypeChart(){
  const box=document.getElementById('tcbox'), read=document.getElementById('tcread');
  box.querySelectorAll('[data-tcty]').forEach(b=>b.onclick=()=>{
    tcSel=tcSel===b.dataset.tcty?null:b.dataset.tcty; renderTypeChart();
    if(tcView==='grid') box.scrollIntoView({behavior:'smooth',block:'start'})});
  const clr=box.querySelector('[data-tcclear]');
  if(clr) clr.onclick=()=>{tcSel=null;renderTypeChart()};
  box.querySelectorAll('[data-tcview]').forEach(b=>b.onclick=()=>{
    tcView=b.dataset.tcview; renderTypeChart()});
  const g=document.getElementById('tcgrid');
  if(!g) return;
  let held=null;
  // The row and the column both light up, so you can trace a matchup across
  // eighteen columns without losing which row you started on; the square where
  // they meet is the one being read out.
  const paint=(a,d)=>{
    g.querySelectorAll('.rc,.hit,.hov').forEach(x=>x.classList.remove('rc','hit','hov'));
    g.classList.toggle('hov',!!a);
    if(!a) return;
    g.querySelectorAll(`td[data-a="${a}"],td[data-d="${d}"]`).forEach(x=>x.classList.add('rc'));
    const cell=g.querySelector(`td[data-a="${a}"][data-d="${d}"]`);
    if(cell) cell.classList.add('hit');
    g.querySelectorAll(`th[data-ty="${a}"],th[data-ty="${d}"]`).forEach(x=>x.classList.add('hov'));
  };
  const say=(a,d,m)=>{read.innerHTML=`<b>${esc(a)}</b> → <b>${esc(d)}</b> is
    <span class="rx" style="color:${m===20?'#0e8a48':m===5?'#c9412a':m===0?'#2c3550':'inherit'}">${
    tcTimes(m)} ${tcWord(m)}</span>.`};
  g.addEventListener('mouseover',e=>{
    const td=e.target.closest('td[data-a]'); if(!td||held) return;
    paint(td.dataset.a,td.dataset.d); say(td.dataset.a,td.dataset.d,+td.dataset.m)});
  g.addEventListener('mouseleave',()=>{if(!held){paint(null);read.innerHTML=tcReadDefault()}});
  g.addEventListener('click',e=>{
    const td=e.target.closest('td[data-a]'); if(!td) return;
    const key=td.dataset.a+'>'+td.dataset.d;
    held=held===key?null:key;
    paint(held?td.dataset.a:null,td.dataset.d);
    if(held) say(td.dataset.a,td.dataset.d,+td.dataset.m)});
}

'''),
(1117, 1131, r'''    <div class="card" id="tcbox"></div>
'''),
(1157, 1157, r'''  renderTypeChart();
'''),
(1265, 1265, r'''/* A bare type is a fair question -- "what beats ice" is not about a route or a
   species, it is about the chart. Direction matters and the phrasing carries it:
   "what beats X" makes X the defender, "what does X beat" makes X the attacker. */
function typeFrom(q){
  // longest first so Fighting is not shadowed by a shorter name inside it
  for(const t of [...TCH.names].sort((a,b)=>b.length-a.length))
    if(new RegExp('\\b'+t.toLowerCase()+'(\\s+type)?\\b').test(q)) return t;
  return null;
}
function typeDir(q,t){
  const tl=t.toLowerCase();
  if(new RegExp('what (does|do|can) (the )?'+tl).test(q)) return 'atk';
  if(new RegExp(tl+'\\s+(type\\s+)?(is\\s+)?(good|strong|super effective|effective)\\s+against').test(q)) return 'atk';
  if(new RegExp(tl+'\\s+(type\\s+)?(beats|hits|counters)').test(q)) return 'atk';
  if(/\bresists?\b/.test(q)) return 'atk';
  return 'def';
}
// Wild-obtainable Pokemon of a given type, hardest hitters first -- so the
// answer is "use one of these", not just "bring a Fighting move".
function monsOfType(t,limit){
  const out=[];
  for(const n in M){
    const m=M[n];
    if(m.hp===undefined||!obtainable(n)||!types(n).includes(t)) continue;
    out.push({n,off:Math.max(statPct(RANK.atk,m.atk||0),statPct(RANK.spa,m.spa||0))});
  }
  out.sort((a,b)=>b.off-a.off||a.n.localeCompare(b.n));
  return out.slice(0,limit||4);
}
function typeAnswer(t,q){
  const dir=typeDir(q,t);
  const hitBy={}, hits={};
  for(const o of TCH.names){
    const m=tmul(o,t); (hitBy[m] ||= []).push(o);          // o attacking t
    const n=tmul(t,o); (hits[n] ||= []).push(o);           // t attacking o
  }
  const supers=hitBy[2]||[];
  const best=supers.flatMap(x=>monsOfType(x,2).map(m=>({...m,t:x})))
    .sort((a,b)=>b.off-a.off).slice(0,6);
  const block=(title,rows)=>`<h4>${title}</h4><div class="mups">${rows.join('')}</div>`;
  const dTable=[
    mulRow('×2','m2',hitBy[2]), mulRow('×½','mh',hitBy[0.5]), mulRow('No effect','m0',hitBy[0])
  ];
  const aTable=[
    mulRow('×2','m2',hits[2]), mulRow('×½','mh',hits[0.5]), mulRow('No effect','m0',hits[0])
  ];
  const parts=[];
  if(dir==='def'){
    parts.push(block(`What beats ${t}`,dTable));
    if(best.length) parts.push(`<h4>Wild-obtainable Pokémon that carry those types</h4>
      <div class="cnts">${best.map(c=>`<button class="cnt" data-sp="${esc(c.n)}" style="${tint(c.n)}">
        ${sprite(c.n,44)}<span class="cmain"><b>${esc(c.n)}</b><span class="ctags">${tyPill(c.t)}
        <span class="cx">offence beats ${c.off}%</span></span></span></button>`).join('')}</div>`);
    parts.push(block(`What ${t} itself hits`,aTable));
  } else {
    parts.push(block(`What ${t} hits — and what shrugs it off`,aTable));
