 ('Polder Town','Safari Zone'), ('Polder Town','Magnolia Town'),
 ('Magnolia Town','Magnolia Fields'), ('Magnolia Town','Cootes Bog'),
 ('Cootes Bog','Crystal Peak'), ('Crystal Peak','Cube Corp'),
 ('Magnolia Fields','Redwood Village'), ('Redwood Village','Redwood Forest'),
]

_mapnames = [m['name'] for m in WORLD['maps']]
_claimed, places = {}, []
for _n, _x, _y, _w, _h, _k, _pre in PLACES:
    _hit = []
    for _nm in _mapnames:
        for _p in _pre:
            if (_nm == _p[:-1]) if _p.endswith('$') else _nm.startswith(_p):
                _hit.append(_nm)
                break
    for _nm in _hit:
        assert _nm not in _claimed, f'{_nm} claimed by both {_claimed[_nm]} and {_n}'
        _claimed[_nm] = _n
    places.append({'n': _n, 'x': _x, 'y': _y, 'w': _w, 'h': _h, 'k': _k, 'ms': _hit})
_off = [n for n in _mapnames if n not in _claimed]
print(f'map: {len(places)} places, {len(_claimed)} of {len(_mapnames)} areas placed, '
      f'{len(_off)} off-map ({sum(1 for n in _off if n.startswith("Unnamed"))} of those unnamed)')

payload['places'] = places
payload['edges'] = EDGES
payload['offmap'] = _off

'''),
(109, 109, r'''/* grid items size to their content by default, so one wide table dragged the
   whole page sideways on a phone -- the views must be allowed to be narrow */
.wrap>div,.wrap>section{min-width:0}
'''),
(234, 247, r'''/* ---------- type chart ----------
   Rotated text headers and three flat colours were unreadable. Every type now
   wears its own colour on both axes, the cells carry a diverging scale, and
   hovering or tapping any cell lights its whole row and column so you can
   actually trace a matchup across eighteen columns. */
.tcbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.tcseg{display:flex;gap:3px;background:var(--s2);padding:4px;border-radius:12px;
  border:1px solid var(--line);flex:none}
.tcseg button{border:0;background:none;font:inherit;font-size:12px;font-weight:800;
  padding:6px 13px;border-radius:9px;color:var(--ink2);cursor:pointer;transition:.13s}
.tcseg button[aria-pressed=true]{background:var(--s1);color:var(--ink);box-shadow:0 2px 6px rgba(13,33,54,.13)}
.tcread{flex:1;min-width:210px;font-size:13px;font-weight:700;color:var(--ink2);
  padding:9px 13px;border-radius:12px;background:var(--s2);border:1px solid var(--line)}
.tcread b{color:var(--ink)}
.tcread .rx{font-weight:800}
.tcpick{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px}
.tcpick button{border:0;font:inherit;cursor:pointer;font-size:10px;font-weight:800;letter-spacing:.05em;
  padding:7px 11px;border-radius:999px;color:#fff;opacity:.74;transition:.13s;text-transform:uppercase}
.tcpick button:hover{opacity:1;transform:translateY(-1px)}
.tcpick button.on{opacity:1;box-shadow:0 4px 12px -3px rgba(13,33,54,.55);transform:translateY(-1px)}
.tcpick .tcclear{background:var(--s3);color:var(--ink2);opacity:1}
.tcwrap{overflow-x:auto;max-width:100%;padding:2px 2px 8px;-webkit-overflow-scrolling:touch}
.tcgrid{border-collapse:separate;border-spacing:3px}
.tcgrid th{padding:0}
.tcgrid th button{border:0;font:inherit;cursor:pointer;font-weight:800;color:#fff;
  border-radius:8px;display:block;transition:.13s;box-shadow:inset 0 -2px 0 rgba(0,0,0,.17)}
.tcgrid thead th button{width:30px;height:32px;font-size:9px;letter-spacing:.02em;padding:0}
.tcgrid tbody th button{width:78px;height:30px;font-size:10px;text-align:left;padding:0 9px;
  letter-spacing:.01em;white-space:nowrap;overflow:hidden}
.tcgrid th button:hover{filter:brightness(1.14)}
.tcgrid th.dim button{opacity:.34}
.tcgrid th.axis button{outline:2px solid var(--ink);outline-offset:2px}
.tcgrid .cnr{font-size:8.5px;font-weight:800;color:var(--ink3);text-align:right;padding-right:8px;
  line-height:1.25;text-transform:uppercase;letter-spacing:.05em}
.tcgrid td{width:30px;height:30px;text-align:center;border-radius:8px;font-weight:800;font-size:11.5px;
  background:var(--s2);color:transparent;transition:opacity .12s}
.tcgrid td.v20{background:linear-gradient(160deg,#3ad07a,#12a054);color:#fff;
  box-shadow:inset 0 -2px 0 rgba(0,0,0,.18)}
.tcgrid td.v5{background:linear-gradient(160deg,#ff9a70,#e04f37);color:#fff;
  box-shadow:inset 0 -2px 0 rgba(0,0,0,.18)}
.tcgrid td.v0{background:linear-gradient(160deg,#525e7d,#1e2536);color:#fff}
.tcgrid td.v10{background:var(--s3)}
.tcgrid td.dim{opacity:.22}
.tcgrid.hov td{opacity:.18}
.tcgrid.hov td.rc{opacity:1}
.tcgrid.hov td.hit{outline:3px solid var(--ink);outline-offset:1px;position:relative;z-index:3}
.tcgrid th.hov button{outline:2px solid var(--ink);outline-offset:2px}
.tclegend{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px;font-size:11.5px;font-weight:700;
  color:var(--ink2);align-items:center}
.tclegend i{display:inline-block;width:14px;height:14px;border-radius:5px;margin-right:6px;vertical-align:-2px}
.tcsum{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.tcsum .tcs{border:1px solid var(--line);border-radius:16px;padding:14px;background:var(--s1)}
.tcsum .tcs h5{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink3);
  margin-bottom:10px;font-weight:800}
.tcsum .tcs h5 em{font-style:normal;color:var(--ink)}
.tchero{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:16px;margin-bottom:12px;
  color:#fff;box-shadow:inset 0 -3px 0 rgba(0,0,0,.18)}
.tchero .tcname{font-size:19px;font-weight:800;letter-spacing:-.01em}
.tchero .tcmeta{font-size:12px;font-weight:700;opacity:.92}
/* ---------- the map ----------
   Regions are drawn in the source map's own 640x480 frame, so the shapes stay
   where they were transcribed from no matter how wide the screen is. */
.mapbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:0 18px 10px}
.mapwrap{overflow-x:auto;padding:0 18px 6px;-webkit-overflow-scrolling:touch}
.mapsvg{width:100%;height:auto;display:block;border-radius:16px;border:1px solid var(--line);
  min-width:600px;background:linear-gradient(160deg,#a8d3ee,#7fb9de)}
.mapsvg .rg{cursor:pointer}
.mapsvg .rg rect{stroke-width:1.4;transition:opacity .12s}
.mapsvg .rg:hover rect{stroke:#0d2136;stroke-width:2.6}
.mapsvg .rg.on rect{stroke:var(--acc);stroke-width:3}
.mapsvg .rg.empty rect{opacity:.5;stroke-dasharray:3 3}
.mapsvg .rg.hit rect{stroke:#0b7f43;stroke-width:3}
.mapsvg.searching .rg:not(.hit){opacity:.32}
.mapsvg text{pointer-events:none;font-family:inherit;font-weight:800;fill:#0f2438}
.mapsvg .road{stroke:#9a8f78;stroke-width:3;fill:none;stroke-linecap:round;stroke-linejoin:round;opacity:.6}
.mapread{flex:1;min-width:200px;font-size:12.5px;font-weight:700;color:var(--ink2);
  padding:8px 12px;border-radius:11px;background:var(--s2);border:1px solid var(--line)}
.mapread b{color:var(--ink)}
.maplegend{display:flex;gap:10px;flex-wrap:wrap;padding:6px 18px 14px;font-size:11px;
  font-weight:700;color:var(--ink2)}
.maplegend span{display:inline-flex;align-items:center;gap:5px}
.maplegend i{width:12px;height:12px;border-radius:4px;display:inline-block;border:1px solid rgba(0,0,0,.18)}
.plhero{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.plhero .pltag{font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;
  padding:4px 10px;border-radius:999px;border:1px solid rgba(0,0,0,.14)}
.offmap{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
'''),
(366, 369, r'''  .tcgrid td{width:24px;height:24px;font-size:10px;border-radius:6px}
  .tcgrid thead th button{width:24px;height:26px;font-size:8px;border-radius:6px}
  .tcgrid tbody th button{width:44px;height:24px;font-size:8.5px;padding:0 6px;border-radius:6px}
  .tcgrid .cnr{font-size:7.5px;padding-right:5px}
  .tcsum{grid-template-columns:1fr}
  .tcread{font-size:12px}
'''),
(417, 418, r'''let selSpecies=null, selLoc=null, selPlace=null, locView='map';
'''),
(872, 872, r'''  const bar=document.getElementById('locsort');
  bar.innerHTML='<div class="tcseg" style="margin-right:6px">'
    +[['map','Map'],['list','List']].map(([k,l])=>
      `<button data-lview="${k}" aria-pressed="${locView===k}">${l}</button>`).join('')+'</div>'
    +(locView==='list'?'<span class="lbl">Sort</span>'+[['story','Story order'],['name','A–Z']].map(
      ([k,l])=>`<button data-lsort="${k}" aria-pressed="${locSort===k}">${l}</button>`).join(''):'');
  bar.querySelectorAll('[data-lview]').forEach(b=>b.onclick=()=>{
    locView=b.dataset.lview; drawLocs()});
  bar.querySelectorAll('[data-lsort]').forEach(b=>b.onclick=()=>{locSort=b.dataset.lsort;drawLocs()});
  const note=document.getElementById('locnote');
