        ${team.length>=6?'<div class="mut">Six is a full team. Drop someone to see suggestions again.</div>'
        :`<div class="sugs">${sug.map(x=>`
          <button class="sug" data-add="${esc(x.n)}" style="${cardTint(x.n)}">
            <div class="sughd">${sprite(x.n,52)}
              <div><b>${esc(x.n)}</b>${badges(x.n)}
                <div class="mut" style="font-size:10.5px;margin-top:3px">BST ${M[x.n].bst||0} ·
                  offence beats ${x.off}% · ${x.badge===0?'available from the start'
                  :x.badge>=9?'route not documented':`from ${x.badge} badge${x.badge===1?'':'s'}`}</div></div>
              <span class="sugadd">+</span></div>
            ${x.why.length?`<ul class="sugwhy">${x.why.slice(0,3).map(w=>`<li>${esc(w)}</li>`).join('')}</ul>`
              :'<div class="mut" style="font-size:11.5px;margin-top:6px">Solid on raw stats.</div>'}
            ${x.but.length?`<div class="sugbut">but ${esc(x.but.slice(0,2).join('; '))}</div>`:''}
            <div class="sugget">${x.route.steps.length
              ? `evolve ${esc(x.route.root)}${x.route.steps.length>1?` (${x.route.steps.length} steps)`:''}`
              : (WHERE[x.n]||[]).length?`wild at ${esc((WHERE[x.n]||[])[0].loc)}`
              : (ACQ[x.n]||[]).length?esc(ACQ[x.n][0].m+(ACQ[x.n][0].w?` · ${ACQ[x.n][0].w}`:''))
              :'route not documented'}</div>
          </button>`).join('')}</div>`}
        <div class="pad" style="padding:14px 0 0"><input type="search" id="tadd"
          placeholder="…or add anyone by name" autocomplete="off"></div>
        <div class="sugs" id="taddout" style="margin-top:10px"></div>
      </div></div>

    ${boss?`<div class="card"><div class="ghd"><h2>Against ${esc(boss.n)}</h2>
      <p class="mut" style="margin-top:8px;font-size:13.5px">How your bench reads against each of their
      Pokémon — best multiplier you can put on it, worst it can put on you.</p></div>
      <div class="gsec">${team.length?`<div class="mons">${boss.p.map(p=>{
        let best=0,bestN='',worst=1,worstN='';
        for(const n of team){
          const h=Math.max(...types(n).map(a=>vsTypes(a,types(p.s)||[])));
          if(h>best){best=h;bestN=n}
          const b=Math.max(...(types(p.s)||[]).map(a=>vsTypes(a,types(n))));
          if(b>worst){worst=b;worstN=n}
        }
        return `<div class="mon" style="${M[p.s]?tint(p.s):''}">
          ${sprite(p.s,44)}<div class="who"><b>${esc(p.s)}</b>
            <span class="mut" style="font-size:11px">Lv ${p.l}${p.i?` · ${esc(p.i)}`:''}</span></div>
          <div class="vsbest ${best>=2?'ok':'no'}">${best?`${best}× — ${esc(bestN)}`:'nothing super effective'}</div>
          <div class="vsback ${worst>=2?'no':'ok'}">${worst>1?`${worst}× back on ${esc(worstN)}`:'nothing scary back'}</div>
        </div>`}).join('')}</div>`
        :'<div class="mut">Add someone and this fills in.</div>'}</div></div>`:''}`;
  const sel=document.getElementById('ttarget');
  sel.onchange=()=>{
    teamTarget=sel.value;
    const b=bossByName(teamTarget);
    // planning for gym 3 means you have two badges, not eight
    if(b) teamBadges=b.gym?Math.max(0,b.gym-1):Math.min(8,gymStage(b.lv)-1);
    drawTeam();
  };
  document.querySelectorAll('#tbadges [data-badge]').forEach(b=>b.onclick=()=>{
    teamBadges=+b.dataset.badge; drawTeam()});
  document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{
    if(team.length<6&&!team.includes(b.dataset.add)){team.push(b.dataset.add); drawTeam()}});
  document.querySelectorAll('[data-drop]').forEach(b=>b.onclick=()=>{
    team=team.filter(x=>x!==b.dataset.drop); drawTeam()});
  const clr=document.getElementById('tclear');
  if(clr) clr.onclick=()=>{team=[]; drawTeam()};
  const ta=document.getElementById('tadd');
  ta.oninput=()=>{
    const q=ta.value.trim().toLowerCase();
    const out=document.getElementById('taddout');
    if(q.length<2){out.innerHTML='';return}
    const hits=Object.keys(M).filter(n=>M[n].hp!==undefined&&SPR.index[n]!==undefined
      &&n.toLowerCase().includes(q)&&!team.includes(n)).slice(0,8);
    out.innerHTML=hits.map(n=>`<button class="sug slim" data-add="${esc(n)}" style="${cardTint(n)}">
      <div class="sughd">${sprite(n,44)}<div><b>${esc(n)}</b>${badges(n)}</div>
      <span class="sugadd">+</span></div></button>`).join('');
    out.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{
      if(team.length<6&&!team.includes(b.dataset.add)){team.push(b.dataset.add); ta.value=''; drawTeam()}});
  };
  wire();
  writeHash();
}

'''),
