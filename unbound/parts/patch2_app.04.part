(2143, 2143, r'''/* ---------------- detail drawer ---------------- */
function drawerOpen(kind,title,html){
  const d=document.getElementById('drawer');
  document.getElementById('dwkind').textContent=kind;
  document.getElementById('dwtitle').textContent=title;
  const body=document.getElementById('dwbody');
  body.innerHTML=html;
  body.scrollTop=0;
  d.classList.add('open');
  document.body.classList.add('dw');
  d.setAttribute('aria-hidden','false');
  wire();
}
function drawerClose(){
  const d=document.getElementById('drawer');
  d.classList.remove('open');
  document.body.classList.remove('dw');
  d.setAttribute('aria-hidden','true');
  selSpecies=null; selLoc=null; selPlace=null;
  // the grid marks the open card, and the map its open region
  if(view==='dex') drawDex();
  if(view==='locs'&&locView==='map') markPlace(null);
  writeHash();
}
addEventListener('keydown',e=>{if(e.key==='Escape'&&document.body.classList.contains('dw')) drawerClose()});

