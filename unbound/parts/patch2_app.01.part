.linkish{border:0;background:none;font:inherit;font-weight:800;color:var(--acc2);cursor:pointer;
  padding:0;text-decoration:underline;text-underline-offset:2px}
.acqevo{margin-top:12px;padding:12px;border-radius:14px;border:1px dashed var(--line2);background:var(--s2)}
.acqevohd{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;
  color:var(--ink3);margin-bottom:8px}
.acqstep{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12.5px;font-weight:700;
  padding:6px 0}
.acqstep .acqhow{color:var(--ink2);font-size:11.5px}
.acqstep .acqto{font-weight:800}
/* ---------- evolution chain ---------- */
.evochain{display:flex;align-items:stretch;gap:10px;overflow-x:auto;padding:2px 0 6px}
.evostage{display:flex;flex-direction:column;gap:8px;justify-content:center;flex:none}
.evolab{font-size:9.5px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;
  color:var(--ink3);text-align:center}
.evoarrow{display:flex;align-items:center;justify-content:center;color:var(--ink3);
  font-size:20px;font-weight:800;flex:none;padding-top:14px}
.evomon{display:flex;flex-direction:column;align-items:center;gap:2px;padding:10px 12px;
  border-radius:15px;border:1px solid var(--line);cursor:pointer;font:inherit;text-align:center;
  min-width:132px;max-width:170px;position:relative;isolation:isolate;overflow:hidden;transition:.14s}
.evomon::before{content:'';position:absolute;inset:0;z-index:-1;background:var(--g);opacity:.55}
.evomon:hover{transform:translateY(-2px);box-shadow:0 12px 24px -14px rgba(13,33,54,.45)}
.evomon b{font-size:13.5px;font-weight:800;line-height:1.2}
.evomon .how{font-size:10.5px;font-weight:700;color:var(--ink2);line-height:1.35;margin-top:2px}
.evomon.cur{border-color:var(--acc);box-shadow:0 0 0 2px var(--accSoft)}
.evomon .youare{font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;
  color:var(--acc2);margin-top:3px}
'''),
(550, 550, r'''/* Eight tabs is one more than the header comfortably holds on a tablet, so it
   tightens and, failing that, scrolls rather than pushing the page sideways. */
@media(max-width:960px){
  h1{font-size:14px}
  .sub{font-size:10.5px}
  .seg{max-width:100%;overflow-x:auto;scrollbar-width:none}
  .seg::-webkit-scrollbar{display:none}
  .seg button{padding:7px 10px;font-size:11.5px;flex:none}
}
'''),
(593, 593, r'''  .tslots{grid-template-columns:repeat(2,1fr)}
  .sugs{grid-template-columns:1fr}
  .vsbest,.vsback{width:auto;text-align:left}
'''),
(824, 825, r'''/* ---------------- evolution ----------------
   The game only ever states evolution forwards -- Gastly carries "Level 25 ->
   Haunter" and Gengar carries nothing -- so a species had no way of knowing what
   it came from. Inverting the table once at load gives every Pokemon its parents,
   and from there the whole family can be walked from its root and drawn as one
   chain, with the species you are looking at marked in it. */
const PRE={}, FORMOF={};
for(const n in M){
  for(const s of M[n].evo||[]){
    const i=s.lastIndexOf('→'); if(i<0) continue;
    const to=s.slice(i+1).trim();
    if(M[to]) (PRE[to] ||= []).push({n,how:s.slice(0,i).trim()});
  }
  // The form table is written both ways round -- Gengar lists Gengar Giga and
  // Gengar Giga lists Gengar right back -- so only keep the link that actually
  // points at a form, or walking it loops forever between the two.
  for(const f of M[n].forms||[])
    if(M[f.to]&&f.to.startsWith(n+' ')) FORMOF[f.to]={n,how:f.how};
}
function evoKids(n){
  const out=[];
  for(const s of (M[n]||{}).evo||[]){
    const i=s.lastIndexOf('→'); if(i<0) continue;
    const to=s.slice(i+1).trim();
    if(M[to]&&SPR.index[to]!==undefined) out.push({n:to,how:s.slice(0,i).trim()});
  }
  return out;
}
function evoRoot(n){
  const seen=new Set([n]);
  let cur=n;
  // guarded rather than while(true): a cyclic table would otherwise hang the page
  for(let g=0;g<8;g++){
    const p=(PRE[cur]||[])[0];
    if(!p||seen.has(p.n)) break;
    seen.add(p.n); cur=p.n;
  }
  return cur;
}
function evoStages(root){
  const stages=[[{n:root,how:''}]], seen=new Set([root]);
  for(let d=0;d<5;d++){
    const next=[];
    for(const node of stages[d]) for(const k of evoKids(node.n))
      if(!seen.has(k.n)){seen.add(k.n); next.push(k)}
    if(!next.length) break;
    stages.push(next);
  }
  return stages;
}
function evoChip(x,cur){
  return `<button class="evomon${x.n===cur?' cur':''}" data-sp="${esc(x.n)}" style="${cardTint(x.n)}">
    ${sprite(x.n,52)}<b>${esc(x.n)}</b>
    ${x.how?`<span class="how">${esc(x.how)}</span>`:''}
    ${x.n===cur?'<span class="youare">you are here</span>':''}</button>`;
}
'''),
(826, 836, r'''  // a Mega or Gigantamax is not its own family -- show the base form's
  const base=FORMOF[name]?FORMOF[name].n:name;
  const root=evoRoot(base), stages=evoStages(root);
  const forms=(M[base]||{}).forms||[];
  const single=stages.length===1&&stages[0].length===1;
  if(single&&!forms.length&&!FORMOF[name]) return `<div class="sec">
    <div class="sechd"><h3>Evolution</h3></div>
    <div class="mut" style="font-size:13px">${esc(name)} neither evolves nor comes from anything —
      it is a family of one.</div></div>`;
  const chain=stages.map((st,i)=>
    `${i?'<div class="evoarrow">→</div>':''}<div class="evostage">
      ${i?`<div class="evolab">Stage ${i+1}</div>`:'<div class="evolab">Base</div>'}
      ${st.map(x=>evoChip(x,name)).join('')}</div>`).join('');
  // Haunter reaches Gengar by trade and by Link Stone; that is one parent, not two
  const pre=[...new Map((PRE[base]||[]).map(p=>[p.n,p])).values()];
  return `<div class="sec"><div class="sechd"><h3>Evolution</h3>
      <span class="mut" style="font-size:11.5px">${
        pre.length?`comes from ${pre.map(p=>esc(p.n)).join(' or ')}`
          :single?'no evolutions':'start of the line'}</span></div>
    ${single?'':`<div class="evochain">${chain}</div>`}
    ${pre.length>1?`<div class="mut" style="font-size:11.5px;margin-top:8px">More than one Pokémon
      evolves into this; the chain above follows ${esc(pre[0].n)}.</div>`:''}
    ${forms.length?`<div class="sechd" style="margin-top:14px"><h3>Forms</h3>
      <span class="mut" style="font-size:11.5px">battle-only transformations, not evolutions</span></div>
      <div class="evochain">${forms.filter(f=>SPR.index[f.to]!==undefined).map(f=>
        `<div class="evostage">${evoChip({n:f.to,how:f.how},name)}</div>`).join('')}</div>`:''}
    ${FORMOF[name]?`<div class="mut" style="font-size:12px;margin-top:10px">${esc(name)} is a form of
      <button class="minipill" data-sp="${esc(FORMOF[name].n)}">${esc(FORMOF[name].n)}</button> —
      ${esc(FORMOF[name].how.toLowerCase())}.</div>`:''}
  </div>`;
}

/* ---------------- how to get it ----------------
   Half the roster is not standing in a patch of grass. A gift, a static, a raid,
   an NPC trade, a Game Corner prize, a swarm hour, a legendary requirement -- or,
   most often, the far end of an evolution line that starts somewhere else
   entirely. Jolteon appears in no table in this game; the honest answer is
   "buy an Eevee for 1500 coins and use a Thunder Stone", and that is two joins
   away from anything the encounter data knows. */
const ACQ={};
{
  // the acquisition rows ship with their strings interned; unpack once
  const A=D.acq||{}, S=A.s||[], pick=i=>i>=0?S[i]:'';
  for(const n in A.r||{}) ACQ[n]=A.r[n].map(a=>
    ({k:a[0],m:pick(a[1]),w:pick(a[2]),d:pick(a[3]),more:a[4]||0}));
}
const ACQK={wild:['Wild','#2fa36a'],gift:['Gift','#c9702a'],static:['Static','#7a52ea'],
  trade:['Trade','#1587e8'],raid:['Raid','#e8348a'],corner:['Game Corner','#b56d00'],
  swarm:['Swarm','#0f8f8f'],legend:['Legendary','#8a5b00'],evo:['Evolution','#c02a09'],
  shop:['Frontier shop','#5a3fa8']};
function acqPill(k){
  const [l,c]=ACQK[k]||['Other','#4d6280'];
  return `<span class="acqk" style="background:${c}1f;color:${c};border-color:${c}55">${l}</span>`;
}
function acqRow(k,main,where,note){
  return `<div class="acqrow">${acqPill(k)}
    <div class="acqmain"><b>${main}</b>${note?`<span class="acqd">${note}</span>`:''}</div>
    ${where?`<div class="acqw">${where}</div>`:''}</div>`;
}
// A direct way in: wild, or anything the acquisition table documents.
function acqDirect(n){
  const out=[], w=WHERE[n]||[];
  for(const x of w.slice(0,3)) out.push(acqRow('wild',
    `<button class="linkish" data-loc="${esc(x.loc)}">${esc(x.loc)}</button>`,
    `${x.pct}% · Lv ${x.min===x.max?x.min:x.min+'–'+x.max}`, esc(x.label)));
