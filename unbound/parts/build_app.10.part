    f'<button data-view="{k}" aria-selected="{str(k == "ask").lower()}">{ICONS[k]}<span>{LABEL[k]}</span></button>'
    for k in ['ask', 'dex', 'locs', 'bosses', 'raids', 'tips'])

HTML = f"""<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Unbound Atlas — Pokémon Unbound 2.1.1.1</title>
<meta name="description" content="Pokédex, wild encounters, raids, bosses and type matchups for Pokémon Unbound 2.1.1.1, generated from the game's published data.">
<style>{CSS}</style>
</head><body>
<header>
  <div class="logo">U</div>
  <div><h1>Unbound Atlas</h1><div class="sub">Pokémon Unbound 2.1.1.1 · Borrius</div></div>
  <div class="grow"></div>
  <div class="seg" id="viewswitch">{nav_desktop}</div>
</header>

<div class="wrap">
  <section class="card" id="searchwrap">
    <div class="pad"><input type="search" id="q" placeholder="Search Pokémon…" autocomplete="off"></div>
    <div id="dexfilters">
      <div class="sortbar" id="sortbar"></div>
      <div class="sortbar statsort" id="statsort"></div>
      <div class="sortbar filters" id="filters"></div>
      <div class="sortbar fsummary" id="fsummary" style="display:none"></div>
      <div class="chips" id="chips"></div>
    </div>
  </section>

  <div id="dexview">
    <section class="card" style="margin-bottom:16px">
      <div class="pad" style="padding-bottom:6px"><div class="sechd">
        <h3>Pokédex</h3><span class="mut" style="font-size:11.5px" id="dexcount"></span></div></div>
      <div id="dexlist"></div>
    </section>
    <div id="dexpanel"></div>
  </div>

  <div id="locsview" style="display:none">
    <section class="card" style="margin-bottom:16px">
      <div class="pad" style="padding-bottom:6px"><div class="sechd">
        <h3>Places</h3><span class="mut" style="font-size:11.5px" id="loccount"></span></div></div>
      <div class="sortbar" id="locsort"></div>
      <div class="note">Unbound publishes no map data — no layouts, coordinates or connections — so there is no
        map here. These are its {len(WORLD['maps'])} encounter areas as a list. Tap one for its full table.</div>
      <div id="loclist"></div>
    </section>
    <div id="locpanel"></div>
  </div>

  <div id="bossesview" style="display:none"><div id="bosslist"></div></div>
  <div id="raidsview" style="display:none"><div id="raidlist"></div></div>
  <div id="tipsview" style="display:none"><div id="tipslist"></div></div>
  <div id="askview" style="display:none"><div id="askbody"></div></div>
  <div id="aboutview" style="display:none"><div id="aboutbody"></div></div>
</div>

<nav class="mobbar" id="mobbar">{nav_mobile}</nav>

<footer>
  Built from Pokémon Unbound's published data — see <b>Sources</b> for exactly which parts come from the
  author and which from the community. Not affiliated with Skeli789, Nintendo, Game Freak or
  The Pokémon Company.
</footer>

<script type="application/json" id="data">__DATA__</script>
<script>{JS}</script>
</body></html>
"""

def emit(pl, sheet_href):
    pl = dict(pl, sprites=dict(pl['sprites'], uri=sheet_href))
    return HTML.replace('__DATA__', json.dumps(pl, separators=(',', ':'))
                        .replace('<', '\\u003c').replace('>', '\\u003e'))

# Single file for downloading: the sheet stays inline so it works with no network.
path = os.path.join(HERE, 'unbound-atlas.html')
open(path, 'w').write(emit(payload, SPRITES['uri']))

# Web build: the sheet is a separate PNG the browser caches, which takes ~950 KB
# of base64 out of the HTML and lets the page paint before the art arrives.
import base64 as _b64
web = os.path.join(HERE, 'public')
os.makedirs(web, exist_ok=True)
open(os.path.join(web, 'sprites.png'), 'wb').write(
    _b64.b64decode(SPRITES['uri'].split(',', 1)[1]))
open(os.path.join(web, 'index.html'), 'w').write(emit(payload, 'sprites.png'))
print('web build:',
      os.path.getsize(os.path.join(web, 'index.html')) // 1024, 'KB html +',
      os.path.getsize(os.path.join(web, 'sprites.png')) // 1024, 'KB png')
print(f'written {os.path.getsize(path)//1024} KB | species={len(mon)} '
      f'maps={len(WORLD["maps"])} bosses={len(WORLD["bosses"])} '
      f'raids={len(WORLD["raids"])} moves={len(MVL)} types={len(TYPES)}')
