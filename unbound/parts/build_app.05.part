  el.querySelectorAll('[data-sort]').forEach(b=>b.onclick=()=>{
    sortBy=b.dataset.sort;statKey=null;drawSort();drawStatSort();drawDex()});
  keepVisible(el);
}
function drawStatSort(){
  const el=document.getElementById('statsort');
  el.innerHTML='<span class="lbl">Base stat</span>'+STATSORTS.map(([k,l])=>
    `<button data-stat="${k}" aria-pressed="${statKey===k}">${l}${
      statKey===k?`<i>${statDir<0?'▼':'▲'}</i>`:''}</button>`).join('');
  el.querySelectorAll('[data-stat]').forEach(b=>b.onclick=()=>{
    const k=b.dataset.stat;
    if(statKey===k) statDir=-statDir; else {statKey=k;statDir=-1}
    sortBy='stat';drawSort();drawStatSort();drawDex()});
  keepVisible(el);
}
function keepVisible(el){
  const on=el.querySelector('[aria-pressed="true"]');
  if(on&&el.scrollWidth>el.clientWidth) on.scrollIntoView({inline:'center',block:'nearest'});
}
function activeF(){
  const out=[];
  if(F.wild) out.push('in the wild');
  if(F.nomega) out.push('no Megas');
  if(F.borrius) out.push('Borrius dex');
  if(F.place) out.push(F.place);
  if(F.sKey&&F.sMin){
    const l=(STATSORTS.find(x=>x[0]===F.sKey)||['','stat'])[1];
    out.push(`${l} ≥ ${F.sMin}`);
  }
  return out;
}
function drawFilters(){
  const el=document.getElementById('filters');
  const opts=D.maps.map(m=>m.name).sort();
  el.innerHTML=`
    <span class="lbl">Only</span>
    <button class="chip" data-f="wild" aria-pressed="${F.wild}">In the wild</button>
    <button class="chip" data-f="nomega" aria-pressed="${F.nomega}">Hide Megas</button>
    <button class="chip" data-f="borrius" aria-pressed="${F.borrius}">Borrius dex</button>
    <select id="fplace" class="sel"><option value="">Anywhere</option>
      ${opts.map(n=>`<option value="${esc(n)}"${F.place===n?' selected':''}>${esc(n)}</option>`).join('')}
    </select>
    <select id="fstat" class="sel"><option value="">Any stat</option>
      ${STATSORTS.map(([k,l])=>`<option value="${k}"${F.sKey===k?' selected':''}>${l}</option>`).join('')}
    </select>
    <input id="fmin" class="num" type="number" min="0" step="5" placeholder="min"
      value="${F.sMin||''}" ${F.sKey?'':'disabled'}>
    ${activeF().length?'<button class="chip clearf" data-f="clear">Clear</button>':''}`;
  // The filter row scrolls sideways on a phone, so an active place or stat can
  // sit off-screen. Restate it somewhere that cannot scroll away.
  const sum=document.getElementById('fsummary');
  const a=activeF();
  sum.innerHTML=a.length?`<span class="lbl">Showing</span>${
    a.map(x=>`<span class="fpill">${esc(x)}</span>`).join('')}
    <button class="chip clearf" data-f="clear">Clear all</button>`:'';
  sum.style.display=a.length?'':'none';
  sum.querySelectorAll('[data-f]').forEach(b=>b.onclick=()=>{
    F={wild:false,nomega:false,borrius:false,place:'',sKey:'',sMin:0};
    drawFilters(); drawDex()});
  el.querySelectorAll('[data-f]').forEach(b=>b.onclick=()=>{
    const k=b.dataset.f;
    if(k==='clear') F={wild:false,nomega:false,borrius:false,place:'',sKey:'',sMin:0};
    else F[k]=!F[k];
    drawFilters(); drawDex()});
  const pl=document.getElementById('fplace');
  pl.onchange=()=>{F.place=pl.value; drawFilters(); drawDex()};
  const st=document.getElementById('fstat');
  st.onchange=()=>{F.sKey=st.value; if(!F.sKey) F.sMin=0; drawFilters(); drawDex()};
  const mn=document.getElementById('fmin');
  if(mn) mn.oninput=()=>{F.sMin=parseInt(mn.value||'0',10)||0; drawDex()};
  keepVisible(el);
}
// Which species each place holds, so the place filter is a set lookup rather
// than a scan of every encounter row per keystroke.
const AT={};
for(const mp of D.maps){
  const set=new Set();
  for(const k in mp.methods) for(const r of mp.methods[k].rows) set.add(r.s);
  AT[mp.name]=set;
}
function passes(n){
  const m=M[n];
  if(F.wild&&!obtainable(n)) return false;
  if(F.nomega&&m.mega) return false;
  if(F.borrius&&!m.rdex) return false;
  if(F.place&&!(AT[F.place]||new Set()).has(n)) return false;
  if(F.sKey&&F.sMin){const v=statOf(n,F.sKey); if(v===null||v<F.sMin) return false}
  return true;
}
function drawChips(){
  const el=document.getElementById('chips');
  const present=[...new Set(Object.keys(M).flatMap(n=>types(n)))].sort();
  el.innerHTML=present.map(t=>{const c=TC[t]||'#A8A77A',on=typeFilter===t,[r,g,b]=rgb(c);
    return `<button class="chip" data-type="${t}" style="${on
      ?`background:${c};color:${inkOn(c)};border-color:${c}`
      :`background:rgba(${r},${g},${b},.16);border-color:rgba(${r},${g},${b},.42);color:var(--ink)`}">${t}</button>`}).join('');
  el.querySelectorAll('[data-type]').forEach(b=>b.onclick=()=>{
    typeFilter=typeFilter===b.dataset.type?null:b.dataset.type;drawChips();drawDex()});
  keepVisible(el);
}

/* ---------------- locations ---------------- */
let locSort='story';
function drawLocs(){
  const q=query.toLowerCase();
  const list=D.maps.filter(m=>!q||m.name.toLowerCase().includes(q)
    ||Object.values(m.methods).some(b=>b.rows.some(r=>r.s.toLowerCase().includes(q))));
  // undated areas go last, not first
  const key=m=>MAPLV[m.name]||999;
  list.sort(locSort==='story'
    ? (a,b)=>(key(a)-key(b))||a.name.localeCompare(b.name)
    : (a,b)=>a.name.localeCompare(b.name));
  const bar=document.getElementById('locsort');
  bar.innerHTML='<span class="lbl">Sort</span>'+[['story','Story order'],['name','A–Z']].map(([k,l])=>
    `<button data-lsort="${k}" aria-pressed="${locSort===k}">${l}</button>`).join('');
  bar.querySelectorAll('[data-lsort]').forEach(b=>b.onclick=()=>{locSort=b.dataset.lsort;drawLocs()});
  let stage=0;
  document.getElementById('loclist').innerHTML = list.length
    ? `<div class="locs">${list.map(m=>{
        const n=Object.values(m.methods).reduce((s,b)=>s+b.rows.length,0);
        return `<button class="loc" data-loc="${esc(m.name)}">
          <b>${esc(m.name)}</b>
          <div class="lm">${Object.values(m.methods).map(b=>b.label).join(' · ')}</div>
          <div class="lm">${n} entr${n===1?'y':'ies'}</div>
          <div class="lm">${MAPLV[m.name]
            ?`from Lv ${MAPLV[m.name]} · ${stageLabel(MAPLV[m.name])}`
            :'level not documented'}</div>
          ${m.unnamed?'<span class="warn">Name not documented</span>'
            :m.inferred?'<span class="warn">Sub-area, name inferred</span>':''}</button>`}).join('')}</div>`
    : '<div class="empty">No location matches.</div>';
  document.getElementById('loccount').textContent=`${list.length} of ${D.maps.length}`;
  wire();
}
function locPanel(name){
  const m=D.maps.find(x=>x.name===name); if(!m) return '';
  return `<div class="card">
    <div class="ghd"><h2>${esc(m.name)}</h2>
      <div class="mut" style="font-size:13px;margin-top:6px">${
        Object.values(m.methods).map(b=>`${b.label} — ${b.rate}% step rate`).join(' · ')}</div></div>
    ${m.unnamed?`<div class="note warn">This area has no documented name. The encounter data lists it only as
      map ${m.g}‑${m.m}; the levels and rates below are real, the name is not known.</div>`
      :m.inferred?`<div class="note warn">A sub-area of <b>${esc(m.near)}</b>. Its own name is not documented —
      matched by encounter contents at ${Math.round(m.inferred*100)}% overlap.</div>`:''}
    ${Object.values(m.methods).map(b=>`<div class="sec">
      <div class="sechd"><h3>${esc(b.label)}</h3>
        <span class="mut" style="font-size:11.5px">${b.rate}% chance per step</span></div>
      <div class="mons">${b.rows.map(r=>`<button class="mon" data-sp="${esc(r.s)}" style="${tint(r.s)}">
        ${sprite(r.s,44)}<div class="who"><b>${esc(r.s)}</b>${badges(r.s)}</div>
        <div class="lv">Lv ${r.min===r.max?r.min:r.min+'–'+r.max}</div>
        <div class="bar"><i style="width:${Math.max(r.pct,2)}%"></i></div>
        <div class="pc">${r.pct}%</div></button>`).join('')}</div></div>`).join('')}
  </div>`;
}

/* ---------------- bosses ---------------- */
function bossPlan(party,lv){
  if(!party.length) return null;
  const known=party.filter(p=>M[p.s]);
  if(!known.length) return null;
  const avg=t=>known.reduce((s,p)=>s+vsMon(t,p.s),0)/known.length;
  const scored=TCH.names.map(t=>({t,v:avg(t),hits:known.filter(p=>vsMon(t,p.s)>1).length}))
    .sort((a,b)=>b.v-a.v);
  const bring=scored.filter(s=>s.v>1.15).slice(0,4);
  const avoid=scored.filter(s=>s.v<0.8).slice(-3).reverse();
  const mons=[];
  for(const n in M){
    const m=M[n]; if(m.hp===undefined||!obtainable(n)) continue;
    if(known.some(p=>p.s===n)) continue;
    if(lv&&earliestLv(n)>lv+4) continue;
    const cov=known.reduce((s,p)=>s+Math.max(...types(n).map(t=>vsTypes(t,types(p.s)))),0)/known.length;
