  ['where',   /\bwhere|find|catch|locate|obtain/],
];
function detect(q){
  const out=new Set();
  for(const [k,re] of INTENT) if(re.test(q.toLowerCase())) out.add(k);
  return out;
}
function locRows(m){
  const rows=[];
  for(const k in m.methods) for(const r of m.methods[k].rows)
    rows.push({...r,label:m.methods[k].label,rate:m.methods[k].rate});
  return rows;
}
function monLine(r,extra){
  return `<button class="mon" data-sp="${esc(r.s)}" style="${tint(r.s)}">${sprite(r.s,44)}
    <div class="who"><b>${esc(r.s)}</b><span class="mut" style="font-size:11.5px">${
      esc(extra||r.label)}</span></div>
    <div class="lv">Lv ${r.min===r.max?r.min:r.min+'–'+r.max}</div>
    <div class="bar"><i style="width:${Math.max(r.pct,2)}%"></i></div>
    <div class="pc">${r.pct}%</div></button>`;
}
function whereElse(name,exclude){
  const w=(WHERE[name]||[]).filter(x=>x.loc!==exclude);
  if(!w.length) return '<span class="mut">nowhere else in the wild</span>';
  return w.slice(0,4).map(x=>`<button class="minipill" data-loc="${esc(x.loc)}">${esc(x.loc)}
    <i>${x.pct}%</i></button>`).join('')+(w.length>4?`<span class="mut" style="font-size:11px">
    +${w.length-4} more</span>`:'');
}
function answer(q){
  const qt=toks(q), want=detect(q);
  if(!qt.length) return {head:'Ask me something',body:
    '<div class="mut">Try naming a place, a Pokémon or a trainer.</div>'};
  const nq=norm(q);
  const loc=bestLoc(qt,nq), sp=bestSpecies(qt,nq), boss=bestBoss(qt,nq);
  // A named Pokemon or trainer outranks a place unless the place was named
  // outright too -- "what beats mimikyu" is not a question about a route.
  const spExact=sp.length&&sp[0].s===99, locExact=loc&&loc.s===99;
  const preferSpecies = spExact && (!locExact) &&
    (want.has('counter')||want.has('where')||!loc||loc.s<99);
  const parts=[]; let head='', sure='';

  // "what do i need for the second gym" -- positional, not by name
  const gym=gymFrom(nq);
  if(gym) return bossAnswer(gym,`Gym ${gym.gym} — ${gym.n}`);
  const lg=leagueFrom(nq);
  if(lg){
    const first=lg[0];
    const a=bossAnswer(first,'The Pokémon League');
    a.sure=`The league is ${lg.length} fights at Lv ${Math.max(...lg.map(x=>x.lv))}. Showing
      <b>${esc(first.n)}</b> first — the rest are below.`;
    a.body+=`<h4>The rest of the league</h4><div class="bosslist">${
      lg.slice(1).map(b=>`<div class="boss"><div class="bhd"><span class="blv">Lv ${b.lv}</span>
        <b>${esc(b.n)}</b>${b.spec?`<span class="bmode">${esc(b.spec)}</span>`:''}</div>
        <div class="party">${b.p.map(p=>`<button class="pm" ${M[p.s]?`data-sp="${esc(p.s)}"`:''}>
          ${sprite(p.s,48)}<span>${esc(p.s)}</span><i>Lv${p.l}</i></button>`).join('')}</div>
        ${planBlock(b.p,b.lv)}</div>`).join('')}</div>`;
    return a;
  }

  // a trainer beats a place: "how do i beat Mirskle" is unambiguous
  if(boss&&(boss.s===99||want.has('counter')||!loc))
    return bossAnswer(boss.b,`Beating ${boss.b.n}`);

  if(loc&&!preferSpecies){
    const m=loc.m, rows=locRows(m);
    head=m.name;
    sure=`Matched <b>${esc(m.name)}</b> — ${rows.length} entries across ${
      Object.keys(m.methods).length} method${Object.keys(m.methods).length===1?'':'s'}.${
      m.unnamed?' This area has no documented name; the encounter data is real, the name is not known.':
      m.inferred?` Listed as a sub-area of ${esc(m.near)}.`:''}${
      loc.alts&&loc.alts.length?`<div class="alts">Or did you mean ${loc.alts.map(a=>
        `<button class="minipill" data-ask="${esc(a)}">${esc(a)}</button>`).join('')}</div>`:''}`;
    if(want.has('strong')){
      const byBst=[...rows].sort((a,b)=>bstOf(b.s)-bstOf(a.s));
      parts.push(`<h4>Strongest things here</h4><div class="mons">${
        byBst.slice(0,6).map(r=>monLine(r,`${r.label} · BST ${bstOf(r.s)}`)).join('')}</div>`);
    }
    if(want.has('rare')||(!want.has('common')&&!want.has('strong'))){
      const rare=[...rows].sort((a,b)=>a.pct-b.pct).slice(0,6);
      parts.push(`<h4>Rarest here</h4><div class="mons">${
        rare.map(r=>monLine(r)).join('')}</div>`);
      if(want.has('where')||/\bthem\b|\belse\b/i.test(q)){
        // one line per species, not per slot: a Pokemon in both the grass and
        // the water here is still one Pokemon to go looking for elsewhere
        const uniq=[...new Set(rare.map(r=>r.s))];
        parts.push(`<h4>Where else those turn up</h4>${uniq.map(n=>
          `<div class="wrow"><b>${esc(n)}</b> ${whereElse(n,m.name)}</div>`).join('')}`);
      }
    }
    if(want.has('common')){
      const cm=[...rows].sort((a,b)=>b.pct-a.pct).slice(0,6);
      parts.push(`<h4>Easiest to find here</h4><div class="mons">${cm.map(r=>monLine(r)).join('')}</div>`);
    }
    if(!parts.length) parts.push(`<div class="mons">${rows.map(r=>monLine(r)).join('')}</div>`);
    parts.push(`<button class="btnlink" data-loc="${esc(m.name)}">Open the full table for ${esc(m.name)}</button>`);
    return {head,sure,body:parts.join('')};
  }

  if(sp.length){
    const n=sp[0].n;
    head=n;
    sure=`Matched <b>${esc(n)}</b>.`;
    if(want.has('counter')){
      const d=defProfile(n);
      parts.push(`<div class="mups">${mulRow('×4','m4',d[4])}${mulRow('×2','m2',d[2])}
        ${mulRow('No effect','m0',d[0])}</div>`);
      parts.push(`<h4>What beats it</h4><div class="cnts">${counters(n,6).map(c=>
        `<button class="cnt" data-sp="${esc(c.n)}" style="${tint(c.n)}">${sprite(c.n,44)}
        <span class="cmain"><b>${esc(c.n)}</b><span class="ctags">${tyPill(c.t)}
        <span class="cx">×${c.x}</span></span></span></button>`).join('')}</div>`);
    } else {
      const w=WHERE[n]||[];
      parts.push(`<h4>Where to find ${esc(n)}</h4>${w.length?`<div class="mons">${
        w.map(x=>`<button class="mon" data-loc="${esc(x.loc)}" style="${tint(n)}">
          <div class="who"><b>${esc(x.loc)}</b><span class="mut" style="font-size:11.5px">${esc(x.label)}${
            x.unnamed?' · unnamed area':''}</span></div>
          <div class="lv">Lv ${x.min===x.max?x.min:x.min+'–'+x.max}</div>
          <div class="bar"><i style="width:${Math.max(x.pct,2)}%"></i></div>
          <div class="pc">${x.pct}%</div></button>`).join('')}</div>`
        :'<div class="mut">Not in any wild encounter table — check Raids, or it may be a gift or evolution.</div>'}`);
    }
    parts.push(`<button class="btnlink" data-sp="${esc(n)}">Open ${esc(n)}</button>`);
    return {head,sure,body:parts.join('')};
  }
  return {head:'No match',sure:'',body:`<div class="mut">Nothing matched
    “${esc(q)}”. Place names come from the encounter data — 26 areas have no documented name at all,
    so if you are somewhere unnamed it will not be findable by name. Try a Pokémon instead.</div>`};
}
const EXAMPLES=[
  'what pokemon do i need to beat the second gym',
  'what are the rare pokemon in flower paradise and where else can i get them',
  'where can i catch larvitar',
  'what beats mimikyu',
  'strongest pokemon in frost mountain',
  'how do i beat mirskle',
  'what should i use against the elite four',
];
function drawAsk(){
  document.getElementById('askbody').innerHTML=`
    <div class="card"><div class="ghd"><h2>Ask</h2>
      <p class="mut" style="margin-top:8px;font-size:14px;max-width:72ch">Type a question in plain English.
      This is not a chatbot — it matches your words against place names, Pokémon and trainers, then answers
      from the same tables the rest of the app uses. It always shows what it matched, so a wrong guess is
      obvious rather than confident.</p>
      <div class="pad" style="padding:14px 0 6px"><input type="search" id="askq"
        placeholder="e.g. what are the rare pokemon in flower paradise?" autocomplete="off"></div>
      <div class="exrow">${EXAMPLES.map(e=>`<button class="ex" data-ex="${esc(e)}">${esc(e)}</button>`).join('')}</div>
    </div>
    <div id="askout"></div></div>`;
  const inp=document.getElementById('askq');
  const run=()=>{
    const q=inp.value.trim();
    if(!q){document.getElementById('askout').innerHTML='';return}
    const a=answer(q);
    document.getElementById('askout').innerHTML=`<div class="gsec">
      <h3>${esc(a.head)}</h3>
      ${a.sure?`<div class="matched">${a.sure}</div>`:''}
      <div class="askans">${a.body}</div></div>`;
    wire();
  };
  inp.oninput=run;
  document.querySelectorAll('.ex').forEach(b=>b.onclick=()=>{inp.value=b.dataset.ex;run()});
  inp.focus();
}

/* ---------------- provenance ---------------- */
function drawAbout(){
  document.getElementById('aboutbody').innerHTML=`
