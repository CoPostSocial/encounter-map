function directBadge(n){
  let best=99;
  for(const x of WHERE[n]||[]) if(x.min>0) best=Math.min(best,badgeFromLv(x.min));
  for(const r of ACQ[n]||[]){
    const txt=`${r.d||''} ${r.w||''}`;
    const m=txt.match(/after (\d)\s*badges?/i);
    let b;
    if(m) b=+m[1];
    else if(/post-?game|elite four|champion/i.test(txt)) b=8;
    else if(r.k==='legend') b=7;
    else b=0;
    best=Math.min(best,b);
  }
  return best;
}
