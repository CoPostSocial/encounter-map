// Encounter methods come out of the table in whatever order the source listed
// them, which put a night grass block between two fishing blocks. Grass first,
// then the rest of the land, then water, then the rods in rod order -- and each
// block gets its own heading rather than repeating the method on every row.
const METHORD=['tall grass','grass','long grass','dark grass','cave','rock smash','headbutt',
  'surf','surfing','old rod','good rod','super rod','fishing'];
function methRank(label){
  const l=label.toLowerCase();
  for(let i=0;i<METHORD.length;i++) if(l.startsWith(METHORD[i])) return i*10+(/night/.test(l)?1:0);
  return 900;
}
function methBlocks(m){
  return Object.values(m.methods).sort((a,b)=>
    methRank(a.label)-methRank(b.label)||a.label.localeCompare(b.label));
}
function methSection(b,size){
  return `<div class="methblk">
    <div class="methhd"><span class="methname">${esc(b.label)}</span>
      <span class="methrate">${b.rate}% per step</span>
      <span class="methn">${b.rows.length} entr${b.rows.length===1?'y':'ies'}</span></div>
    <div class="mons">${b.rows.map(r=>`<button class="mon" data-sp="${esc(r.s)}" style="${tint(r.s)}">
      ${sprite(r.s,size||44)}<div class="who"><b>${esc(r.s)}</b>${badges(r.s)}</div>
      <div class="lv">Lv ${r.min===r.max?r.min:r.min+'–'+r.max}</div>
      <div class="bar"><i style="width:${Math.max(r.pct,2)}%"></i></div>
      <div class="pc">${r.pct}%</div></button>`).join('')}</div></div>`;
'''),
