"""Second hop: bring build_app.py from the shipped patch to this build.

patch_app takes the checksummed parts to the build that added the map; this
carries everything since. Regenerate THIS file for the next change rather than
adding a third hop -- and when it passes roughly 60 KB, re-split build_app.py
into fresh parts and delete both patches, because at that point the patch costs
more than the file.

Same contract at both ends: it refuses to run unless the file it is handed is
exactly what patch_app produced, and refuses to finish unless the result hashes
to the build that was actually tested.
"""
import hashlib, os

BASE = 'e31b6470b8a23dbb1f729dff7518cbd50e0771c2c330db0cd60e2ce11f729da7'
WANT = '16bb7062356c03ef86759e9cb281b600d3e27abbf17c8a3d4dea2a4eae45a6de'
path = os.path.join(os.environ.get('UBROOT', '.'), 'build_app.py')
src = open(path, encoding='utf-8').read()
got = hashlib.sha256(src.encode()).hexdigest()
assert got == BASE, 'build_app.py is not what patch_app produced: ' + got

EDITS = [
(75, 75, r'''    'acq': WORLD.get('acq', {}),
'''),
(429, 429, r'''/* ---------- detail drawer ----------
   The detail used to render underneath the grid and smooth-scroll to itself,
   which on a 1024-card Pokedex meant a long ride down and a longer one back.
   It is a docked panel now: on a wide screen the page gives up the room and the
   grid stays live beside it, so picking a second Pokemon just swaps the panel.
   On a phone it is a full-height sheet with its own close. */
.drawer{position:fixed;z-index:400;background:var(--bg);display:flex;flex-direction:column;
  visibility:hidden}
.drawer.open{visibility:visible}
.dwhd{display:flex;align-items:center;gap:10px;padding:10px 14px;flex:none;
  background:rgba(255,255,255,.94);backdrop-filter:blur(14px);border-bottom:3px solid var(--line)}
.dwhd .dwt{font-size:15px;font-weight:800;letter-spacing:-.01em;flex:1;min-width:0;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dwhd .dwk{font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;
  color:var(--ink3);flex:none}
.dwx{border:1px solid var(--line);background:var(--s2);color:var(--ink2);border-radius:999px;
  width:34px;height:34px;flex:none;cursor:pointer;font:inherit;font-size:15px;font-weight:800;
  display:grid;place-items:center}
.dwx:hover{background:var(--accSoft);color:var(--acc2);border-color:var(--acc)}
.dwbody{flex:1;overflow-y:auto;overscroll-behavior:contain;padding:14px;
  -webkit-overflow-scrolling:touch}
.dwbody .card{margin-bottom:14px}
@media (min-width:940px){
  :root{--dw:min(640px,46vw)}
  .drawer{top:0;right:0;bottom:0;width:var(--dw);border-left:3px solid var(--line2);
    box-shadow:-24px 0 50px -28px rgba(13,33,54,.45);
    transform:translateX(101%);transition:transform .2s cubic-bezier(.2,.8,.3,1),visibility .2s}
  .drawer.open{transform:none}
  /* the page yields the space rather than being covered, so the grid stays usable */
  body.dw header,body.dw .wrap,body.dw footer{padding-right:calc(var(--dw) + 18px)}
}
@media (max-width:939px){
  .drawer{inset:0;transform:translateY(100%);transition:transform .22s cubic-bezier(.2,.8,.3,1),visibility .22s}
  .drawer.open{transform:none}
  body.dw{overflow:hidden}
  .dwbody{padding:12px 12px 26px}
}
/* ---------- encounter method blocks ---------- */
.methblk{margin-bottom:14px}
.methblk:last-child{margin-bottom:0}
.methhd{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;margin:0 0 8px;padding:6px 11px;
  border-radius:10px;background:var(--s3)}
.methhd .methname{font-size:12px;font-weight:800;letter-spacing:.02em}
.methhd .methrate{font-size:11px;font-weight:800;color:var(--ink2)}
.methhd .methn{font-size:11px;font-weight:700;color:var(--ink3);margin-left:auto}
/* ---------- lineup builder ---------- */
.tbar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:14px}
.tlab{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:800;text-transform:uppercase;
  letter-spacing:.07em;color:var(--ink3)}
.tlab .sel{max-width:320px;text-transform:none;letter-spacing:0;font-size:12.5px;color:var(--ink2)}
.tbadges{display:flex;gap:3px}
.tbadges button{border:1px solid var(--line);background:var(--s2);color:var(--ink2);width:26px;height:26px;
  border-radius:8px;font:inherit;font-size:11.5px;font-weight:800;cursor:pointer}
.tbadges button[aria-pressed=true]{background:var(--acc);color:var(--accInk);border-color:var(--acc)}
.tslots{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:9px}
.tslot{position:relative;border:1px solid var(--line);border-radius:15px;padding:10px;min-height:118px;
  display:flex;align-items:center;justify-content:center;overflow:hidden;isolation:isolate}
.tslot.empty{border-style:dashed;color:var(--ink3);flex-direction:column;gap:4px;font-weight:800}
.tslot.empty span{font-size:17px}
.tslot.empty em{font-style:normal;font-size:11px;text-transform:uppercase;letter-spacing:.08em}
.tface{border:0;background:none;font:inherit;cursor:pointer;display:flex;flex-direction:column;
  align-items:center;gap:3px;text-align:center;width:100%}
.tface b{font-size:13.5px;font-weight:800}
.tdrop{position:absolute;top:6px;right:6px;z-index:2;border:1px solid var(--line);background:var(--s1);
  color:var(--ink3);width:22px;height:22px;border-radius:999px;cursor:pointer;font:inherit;font-size:11px;
  font-weight:800;display:grid;place-items:center}
.tdrop:hover{background:var(--accSoft);color:var(--acc2);border-color:var(--acc)}
.tslot.late{border-color:#e0a800;box-shadow:inset 0 0 0 1px rgba(224,168,0,.4)}
.tlate{font-size:9.5px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:#a37400}
.cover{display:grid;grid-template-columns:repeat(auto-fill,minmax(78px,1fr));gap:5px;margin-top:14px}
.covc{border:1px solid var(--line);border-radius:10px;padding:6px;text-align:center;background:var(--s2)}
.covc.good{background:rgba(47,163,106,.13);border-color:rgba(47,163,106,.4)}
.covc.bad{background:rgba(224,79,55,.12);border-color:rgba(224,79,55,.36)}
.covc .covt{display:block;font-size:8.5px;font-weight:800;letter-spacing:.04em;padding:3px 0;
  border-radius:6px;margin-bottom:4px}
.covc .covo{display:block;font-size:12px;font-weight:800}
.covc .covw{display:block;font-size:9.5px;font-weight:700;color:var(--ink3)}
.sugs{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:9px}
.sug{border:1px solid var(--line);border-radius:15px;padding:11px;cursor:pointer;font:inherit;
  text-align:left;position:relative;isolation:isolate;overflow:hidden;transition:.14s;background:none}
.sug::before{content:'';position:absolute;inset:0;z-index:-1;background:var(--g);opacity:.5}
.sug:hover{transform:translateY(-2px);box-shadow:0 14px 26px -16px rgba(13,33,54,.5);border-color:var(--acc)}
.sughd{display:flex;align-items:center;gap:10px}
.sughd b{font-size:14px;font-weight:800;display:block;margin-bottom:3px}
.sugadd{margin-left:auto;flex:none;width:26px;height:26px;border-radius:999px;background:var(--acc);
  color:var(--accInk);display:grid;place-items:center;font-size:15px;font-weight:800}
.sugwhy{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:3px}
.sugwhy li{font-size:11.5px;font-weight:700;color:var(--ink2);padding-left:12px;position:relative}
.sugwhy li::before{content:'▸';position:absolute;left:0;color:var(--acc2)}
.sugbut{margin-top:6px;font-size:11px;font-weight:700;color:#a37400;padding-left:12px;position:relative}
.sugbut::before{content:'!';position:absolute;left:2px;font-weight:800}
.sugget{margin-top:8px;font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;
  color:var(--ink3)}
.sug.slim .sugwhy,.sug.slim .sugget{display:none}
.vsbest,.vsback{font-size:11px;font-weight:800;flex:none;width:150px;text-align:right}
.vsbest.ok{color:#0b7f43}
.vsbest.no{color:#c9412a}
.vsback.no{color:#c9412a}
.vsback.ok{color:var(--ink3)}
/* ---------- how to get it ---------- */
.acqlist{display:grid;gap:7px}
.acqrow{display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:12px;
  border:1px solid var(--line);background:var(--s2);flex-wrap:wrap}
.acqk{font-size:9.5px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;
  padding:4px 9px;border-radius:999px;border:1px solid;flex:none}
.acqmain{flex:1;min-width:140px;font-size:13px;font-weight:700}
.acqmain b{font-weight:800}
.acqd{display:block;font-size:11.5px;font-weight:700;color:var(--ink2);margin-top:2px;line-height:1.4}
.acqw{font-size:11.5px;font-weight:800;color:var(--ink2);flex:none}
