"""Second hop: bring build_app.py from the deployed build up to this one.

patch_app already takes the shipped parts to the build that added the map. This
carries the next change on top rather than regenerating that whole patch, which
had grown to 41 KB. Same contract at both ends: it refuses to run unless the
file it is handed is exactly what patch_app produced, and refuses to finish
unless the result hashes to the build that was tested.

Two hops is the limit worth keeping. The next change should re-split
build_app.py into fresh parts and delete both patches.
"""
import hashlib, os

BASE = 'e31b6470b8a23dbb1f729dff7518cbd50e0771c2c330db0cd60e2ce11f729da7'
WANT = '38ba19be8835416f486f04eefa4d3a93731e638c9e8c8fee0f7be994879b7fcd'
path = os.path.join(os.environ.get('UBROOT', '.'), 'build_app.py')
src = open(path, encoding='utf-8').read()
got = hashlib.sha256(src.encode()).hexdigest()
assert got == BASE, 'build_app.py is not what patch_app produced: ' + got

