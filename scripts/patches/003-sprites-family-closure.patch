+def family_closure(rk, base):
+    """Every species reachable through evolution from something catchable.
+
+    The atlas draws whole evolution lines, and most later stages -- Flareon,
+    Beautifly, Alakazam -- never appear in a wild encounter table, so basing
+    the sheet on encounterable species alone leaves them with no sprite."""
+    up, down = {}, {}
+    for src, steps in extras[rk]['evos'].items():
+        for s in steps:
+            dst = s.rsplit('→', 1)[-1].strip()
+            down.setdefault(src, []).append(dst)
+            up[dst] = src
+    fam, stack = set(base), list(base)
+    while stack:
+        n = stack.pop()
+        for nxt in down.get(n, []) + ([up[n]] if n in up else []):
+            if nxt not in fam:
+                fam.add(nxt)
+                stack.append(nxt)
+    return fam
+
