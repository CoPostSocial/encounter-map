+/* ---------------- stats in context ---------------- */
+// Share of the 386 Pokemon this value beats, ties counted at their midpoint.
+function statPct(sorted,v){
+  let lo=0,hi=sorted.length;
+  while(lo<hi){const mid=(lo+hi)>>1; if(sorted[mid]<v) lo=mid+1; else hi=mid;}
+  let up=lo; while(up<sorted.length&&sorted[up]===v) up++;
+  return Math.round((lo+up)/2/sorted.length*100);
+}
+const TIERS=[[92,'Elite','t5'],[75,'Strong','t4'],[55,'Above average','t3'],
+             [30,'Below average','t2'],[0,'Weak','t1']];
+function tier(p){return TIERS.find(t=>p>=t[0])}
+function role(n){
+  const m=R.mon[n]; if(!m||m.hp===undefined) return null;
+  const p={}; for(const [k] of STATS) p[k]=statPct(R.rank[k],m[k]||0);
+  const bulk=Math.round((p.hp+p.def+p.spd)/3), off=Math.max(p.atk,p.spa), gap=p.atk-p.spa;
+  let head;
+  if(off>=55) head=gap>12?'Physical attacker':gap<-12?'Special attacker':'Mixed attacker';
+  else if(bulk>=58) head='Defensive';
+  else head='All-rounder';
+  const tags=[];
+  if(p.spe>=80) tags.push('very fast'); else if(p.spe>=62) tags.push('fast');
+  else if(p.spe<=20) tags.push('very slow'); else if(p.spe<=38) tags.push('slow');
+  if(bulk>=76) tags.push('bulky'); else if(bulk<=24) tags.push('frail');
+  return {p,bulk,off,text:head+(tags.length?' · '+tags.join(', '):'')};
+}
