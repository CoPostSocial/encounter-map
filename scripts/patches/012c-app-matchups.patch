+/* How to prepare for one fight: which attacking type lands on the most of the
+   party, which type the party shrugs off, and who in this game brings it. */
+// The lowest level this Pokemon ever turns up at, which stands in for "could I
+// have it by now". Gifts and trades come with no level, so they count as early.
+function earliestLv(n){
+  const rs=R.species[n]||[]; if(!rs.length) return 99;
+  return Math.min(...rs.map(r=>r.min||0));
+}
+function bossPlan(party,lv){
+  if(!R.tc||!party.length) return null;
+  const avg=t=>party.reduce((s,m)=>s+vsMon(t,m.s),0)/party.length;
+  const scored=R.tc.names.map(t=>({t,v:avg(t),
+    hits:party.filter(m=>vsMon(t,m.s)>1).length})).sort((a,b)=>b.v-a.v);
+  const bring=scored.filter(s=>s.v>1.15).slice(0,4);
+  const avoid=scored.filter(s=>s.v<0.8).slice(-3).reverse();
+  const mons=[];
+  for(const n of Object.keys(R.species)){
+    const m=R.mon[n]; if(!m||m.hp===undefined||isSetPiece(n)) continue;
+    if(party.some(p=>p.s===n)) continue;
+    // Recommending Gyarados for the first gym is useless: nothing shows up in
+    // the wild much above the level of the fight you are walking into.
+    if(lv&&earliestLv(n)>lv+4) continue;
+    const cov=party.reduce((s,p)=>s+Math.max(...types(n).map(t=>vsTypes(t,types(p.s)))),0)/party.length;
+    if(cov<=1.15) continue;
+    const back=party.reduce((s,p)=>s+Math.max(...types(p.s).map(t=>vsMon(t,n))),0)/party.length;
+    const off=Math.max(statPct(R.rank.atk,m.atk||0),statPct(R.rank.spa,m.spa||0));
+    mons.push({n,cov,back,score:cov*100+off/2-(back>1.3?35:0)});
+  }
+  mons.sort((a,b)=>b.score-a.score||a.n.localeCompare(b.n));
+  return {bring,avoid,mons:mons.slice(0,4)};
+}
+function planBlock(party,lv){
+  const p=bossPlan(party,lv); if(!p||(!p.bring.length&&!p.mons.length)) return '';
+  return `<details class="plan"><summary>How to beat it</summary>
+    <div class="planbody">
+      ${p.bring.length?`<div class="mrow m2"><span class="mlab">Bring</span><span class="mlist">${
+        p.bring.map(s=>tyPill(s.t,` <b style="font-weight:800">${s.hits}/${party.length}</b>`)).join('')}</span></div>`:''}
+      ${p.avoid.length?`<div class="mrow mh"><span class="mlab">Avoid</span><span class="mlist">${
+        p.avoid.map(s=>tyPill(s.t)).join('')}</span></div>`:''}
+      ${p.mons.length?`<div class="cnts" style="margin-top:9px">${p.mons.map(c=>
+        `<button class="cnt" data-sp="${c.n}" style="${tint(c.n)}">${sprite(c.n,44)}
+          <span class="cmain"><b>${c.n}</b><span class="ctags">
+            <span class="cx">×${c.cov.toFixed(2)} average</span>
+            ${c.back>1.3?'<span class="cback">✕ takes extra back</span>':''}</span></span></button>`).join('')}</div>`:''}
+      <div class="mut" style="font-size:11px;margin-top:9px">The number on a type is how many of the party it
+        hits for extra damage. The Pokémon below are ones you can get in ${R.game}, ranked on how well their own
+        types cover the whole party — not on a moveset, so check what they actually learn.</div>
+    </div></details>`;
+}
