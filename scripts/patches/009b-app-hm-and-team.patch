 /* ---------------- guide ---------------- */
+// How many of the eight HMs a Pokemon can carry. Field moves eat move slots,
+// so one Pokemon covering four of them frees up the rest of the team.
+function hmTable(){
+  // t[3] is 0 for a machine the game never hands out, which is how FireRed's
+  // leftover HM08 Dive stays out of the count.
+  const hms=R.tmhm.map((t,i)=>({n:t[0],mv:t[2],i,ok:t[3]!==0}))
+                  .filter(x=>x.n.startsWith('HM')&&x.ok);
+  const rows=[];
+  for(const name of Object.keys(R.species)){
+    const L=R.learn[name]; if(!L||!L.t||isSetPiece(name)) continue;
+    const got=[], bits=tmBits(L.t);
+    for(const h of hms) if(bits[h.i]) got.push(h);
+    if(!got.length) continue;
+    const m=R.mon[name]||{};
+    rows.push({name,got,n:got.length,bst:STATS.reduce((s,[k])=>s+(m[k]||0),0)});
+  }
+  rows.sort((a,b)=>b.n-a.n||b.bst-a.bst||a.name.localeCompare(b.name));
+  return {hms,rows};
+}
+// A set-piece legendary is a fine Pokemon and a useless recommendation: you get
+// it once, near the end. Anything you can only meet as a static high-level
+// battle is out of the team builder.
+function isSetPiece(name){
+  const rs=R.species[name]||[];
+  return rs.length>0 && rs.every(r=>r.k==='static') && rs.some(r=>(r.min||0)>=40);
+}
+function buildTeam(){
+  const hm=hmTable(), byName={};
+  hm.rows.forEach(r=>byName[r.name]=r);
+  const pool=Object.keys(R.species).filter(n=>{
+    const m=R.mon[n]; return m&&m.hp!==undefined&&!isSetPiece(n);
+  });
+  const team=[], haveT=new Set(), haveH=new Set();
+  while(team.length<6){
+    let best=null;
+    for(const n of pool){
+      if(team.includes(n)) continue;
+      const ts=types(n), hs=(byName[n]?byName[n].got:[]).map(h=>h.n);
+      const newT=ts.filter(t=>!haveT.has(t)).length;
+      const newH=hs.filter(h=>!haveH.has(h)).length;
+      const m=R.mon[n], bst=STATS.reduce((s,[k])=>s+(m[k]||0),0);
+      // Rank the tiebreak on what a Pokemon does in a fight, not on stat total:
+      // Shuckle's 505 is almost all defence and it wins nothing.
+      const use=Math.round((Math.max(statPct(R.rank.atk,m.atk||0),
+                                     statPct(R.rank.spa,m.spa||0))
+                            + statPct(R.rank.spe,m.spe||0))/2);
+      const sc=newT*3+newH*2+use/30;
+      if(!best||sc>best.sc) best={n,sc,newT,newH,ts,hs,bst,use};
+    }
+    if(!best) break;
+    best.ts.forEach(t=>haveT.add(t));
+    best.hs.forEach(h=>haveH.add(h));
+    team.push(best.n);
+    best.picked=team.length;
+    (team.why=team.why||[]).push(best);
+  }
+  return {team:team.why||[],types:haveT,hms:haveH,allHM:hm.hms};
+}
