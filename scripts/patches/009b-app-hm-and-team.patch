+/* ---------------- bosses and the big set-piece encounters ---------------- */
+const BOSSRANK={'Leader':1,'Elite Four':2,'Champion':3,'Rival':4,'Boss':5,
+                'Aqua Leader':5,'Magma Leader':5,'Aqua Admin':6,'Magma Admin':6};
+function drawBosses(){
+  // Trainer fights and the static legendaries are the same thing from where you
+  // are standing: a single scripted battle you prepare for. Interleave them by
+  // level, which in both games is the order you meet them.
+  const rows=[];
+  for(const b of (R.bosses||[])){
+    const pl=R.places[b.sec];
+    rows.push({kind:'t',lv:b.lv,b,place:pl,name:pl?pl.name:b.sec.replace('MAPSEC_','')});
+  }
+  for(const [sec,list] of Object.entries(R.scripted||{})){
+    if(sec==='TRADES') continue;
+    const pl=R.places[sec];
+    for(const e of list){
+      if(e.k!=='static') continue;
+      rows.push({kind:'m',lv:e.l||0,e,place:pl,name:e.m||(pl?pl.name:sec)});
+    }
+  }
+  rows.sort((a,b)=>a.lv-b.lv||(BOSSRANK[a.b?.c]||9)-(BOSSRANK[b.b?.c]||9));
+  const nT=rows.filter(r=>r.kind==='t').length, nM=rows.length-nT;
+  document.getElementById('bossbody').innerHTML=`
+    <section class="card"><div class="ghd"><h2>Every big fight in ${R.game}</h2>
+      <p class="mut" style="margin:8px 0 0;max-width:70ch;font-size:14px">${nT} trainers worth preparing for and
+      ${nM} legendaries and set-piece battles, in the order their levels put them. Gym leaders, the Elite Four,
+      the champion, your rival, the team bosses — full parties with the moves they actually carry.
+      Tap any Pokémon to open it, or the location to find it on the map.</p></div></section>
+    <section class="card"><div class="gsec">
+      <div class="bosslist">${rows.map(bossCard).join('')}</div></div></section>`;
+  const d=document.getElementById('bossbody');
+  d.querySelectorAll('[data-sp]').forEach(x=>x.onclick=()=>{setView('atlas');setTab('mons');selectSpecies(x.dataset.sp)});
+  d.querySelectorAll('[data-place]').forEach(x=>x.onclick=()=>{
+    setView('atlas');setTab('places');selectPlace(R.places[x.dataset.place])});
+}
+function bossCard(r){
+  const where=r.place?`<button class="bwhere" data-place="${r.place.id}">📍 ${r.name}</button>`
+                     :`<span class="bwhere">📍 ${r.name}</span>`;
+  if(r.kind==='m'){
+    const c=tcol(r.e.s);
+    return `<div class="boss legend" style="${tint(r.e.s)}">
+      <div class="bhd"><span class="blv">Lv ${r.lv}</span>
+        <b>${r.e.s}</b><span class="bcls" style="background:${c};color:${inkOn(c)}">Legendary</span></div>
+      <div class="party"><div class="pm" data-sp="${r.e.s}">${sprite(r.e.s,48)}<span>${r.e.s}</span><i>Lv${r.lv}</i></div></div>
+      ${where}</div>`;
+  }
+  const b=r.b;
+  return `<div class="boss">
+    <div class="bhd"><span class="blv">Lv ${r.lv}</span><b>${b.n}</b>
+      <span class="bcls">${b.c}</span>${b.d?'<span class="pill">Double</span>':''}
+      ${b.alt?`<span class="mut" style="font-size:11px">${b.alt} party variants</span>`:''}</div>
+    <div class="party">${b.p.map(m=>`<div class="pm" data-sp="${m.s}" title="${(m.m||[]).join(', ')}">
+      ${sprite(m.s,48)}<span>${m.s}</span><i>Lv${m.l}</i>
+      ${m.i?`<em>${m.i}</em>`:''}
+      ${(m.m||[]).filter(x=>x&&x!=='None').length?`<u>${m.m.filter(x=>x&&x!=='None').join(' · ')}</u>`:''}</div>`).join('')}</div>
+    ${where}</div>`;
+}
