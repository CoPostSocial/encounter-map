+// Base stats get their own line: seven more pills crammed into the sort row
+// reads as noise, and a stat sort wants a direction of its own. First tap is
+// highest first, because "who is the fastest thing here" is the question people
+// actually have; tapping the same stat again flips it.
+const STATSORTS=[['bst','Total'],...STATS];
+function drawStatSort(){
+  const el=document.getElementById('statsort');
+  if(tab!=='mons'){el.innerHTML=''; el.style.display='none'; return}
+  el.style.display='';
+  el.innerHTML=`<span class="lbl">Base stat</span>`+STATSORTS.map(([k,l])=>
+    `<button data-stat="${k}" aria-pressed="${statKey===k}">${l}${
+      statKey===k?`<i>${statDir<0?'▼':'▲'}</i>`:''}</button>`).join('');
+  el.querySelectorAll('[data-stat]').forEach(b=>b.onclick=()=>{
+    const k=b.dataset.stat;
+    if(statKey===k) statDir=-statDir; else {statKey=k; statDir=-1}
+    sortBy='stat'; drawSort(); renderList()});
+  keepVisible(el);
+}
+// These rows scroll sideways on a phone, so a pill picked from the far end
+// would otherwise vanish the moment the row redraws.
+function keepVisible(el){
+  const on=el.querySelector('[aria-pressed="true"]');
+  if(on&&el.scrollWidth>el.clientWidth) on.scrollIntoView({inline:'center',block:'nearest'});
+}
+function statOf(n,k){
+  const m=R.mon[n]; if(!m) return null;
+  if(k==='bst'){ if(m.hp===undefined) return null;
+                 return STATS.reduce((s,[j])=>s+(m[j]||0),0) }
+  return m[k]===undefined?null:m[k];
 }
