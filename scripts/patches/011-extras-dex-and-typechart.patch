+def build_dex(repo):
+    """National Dex number, category, height and weight.
+
+    The species table is in internal order, not Dex order; pokedex.h holds the
+    National order as a plain enum, and every species maps to the entry of the
+    same name.
+    """
+    num, i = {}, 0
+    src = open(os.path.join(repo, 'include/constants/pokedex.h')).read()
+    body = src.split('enum', 1)[1]
+    for m in re.finditer(r'NATIONAL_DEX_(\w+)', body[:body.index('}')]):
+        if m.group(1) == 'NONE':
+            continue
+        i += 1
+        num[m.group(1)] = i
+    ent = {}
+    p = os.path.join(repo, 'src/data/pokemon/pokedex_entries.h')
+    if os.path.exists(p):
+        for const, blk in keyed_blocks(open(p).read(), r'\[NATIONAL_DEX_(\w+)\]\s*=\s*\{'):
+            cat = re.search(r'\.categoryName\s*=\s*_\("([^"]*)"\)', blk)
+            h = re.search(r'\.height\s*=\s*(\d+)', blk)
+            w = re.search(r'\.weight\s*=\s*(\d+)', blk)
+            ent[const] = (cat.group(1).title() if cat else '',
+                          int(h.group(1)) if h else 0, int(w.group(1)) if w else 0)
+    return num, ent
+
