+# ---------------------------------------------------------------- type chart
+def build_typechart(repo):
+    """The Gen III matchup table, read out of battle_main.c.
+
+    The table is a flat list of (attacking type, defending type, multiplier)
+    triples where the multiplier is fixed-point tenths: 20 is x2, 05 is x0.5,
+    00 is an immunity. Anything not listed is x1, so only the exceptions are
+    stored. A TYPE_FORESIGHT sentinel sits near the end: everything after it is
+    still a real matchup, it is only the block the game skips once a Ghost has
+    been Foresighted -- which is to say Normal and Fighting failing against
+    Ghost. Stopping at that sentinel loses both immunities, so skip the sentinel
+    row itself and read on to TYPE_ENDTABLE.
+    """
+    order = {}
+    for m in re.finditer(r'#define\s+(TYPE_\w+)\s+(\d+)',
+                         open(os.path.join(repo, 'include/constants/pokemon.h')).read()):
+        order[m.group(1)] = int(m.group(2))
+    src = open(os.path.join(repo, 'src/battle_main.c')).read()
+    body = re.search(r'gTypeEffectiveness\[\d*\]\s*=\s*\{(.*?)\n\};', src, re.S).group(1)
+    MUL = {'TYPE_MUL_NO_EFFECT': 0, 'TYPE_MUL_NOT_EFFECTIVE': 5,
+           'TYPE_MUL_SUPER_EFFECTIVE': 20, 'TYPE_MUL_NORMAL': 10}
+    chart = {}
+    for a, d, mul in re.findall(r'(TYPE_\w+)\s*,\s*(TYPE_\w+)\s*,\s*(TYPE_MUL_\w+)', body):
+        if a == 'TYPE_ENDTABLE':
+            break
+        if a == 'TYPE_FORESIGHT':
+            continue
+        chart.setdefault(a[5:].title(), {})[d[5:].title()] = MUL[mul]
+    # TYPE_MYSTERY is the "???" slot Curse uses; nothing is ever that type.
+    names = [k[5:].title() for k, v in sorted(order.items(), key=lambda kv: kv[1])
+             if v < 100 and k != 'TYPE_MYSTERY']
+    return {'names': names, 'chart': chart}
+
