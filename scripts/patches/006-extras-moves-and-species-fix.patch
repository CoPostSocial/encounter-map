+def keyed_blocks(src, pattern):
+    """Split a C designated-initialiser table on its keys.
+
+    Brace-matching with a non-greedy body breaks the moment one entry is
+    written on a single line -- "[SPECIES_NONE] = {0}," swallowed Bulbasaur,
+    which is why Bulbasaur had no stats and an entry called "None" had his.
+    """
+    keys = list(re.finditer(pattern, src))
+    for i, m in enumerate(keys):
+        end = keys[i + 1].start() if i + 1 < len(keys) else len(src)
+        yield m.group(1), src[m.end():end]
+
