+# ---------------------------------------------------------------- moves
+def build_moves(repo):
+    """Every move's type, power, accuracy, PP, description, and whether it is
+    physical or special.
+
+    Gen III has no per-move category: the split is by type, and battle.h states
+    the rule as IS_TYPE_PHYSICAL(t) == (t < TYPE_MYSTERY). Read both the type
+    order and that threshold out of the source rather than hardcoding a list.
+    """
+    order = {}
+    for m in re.finditer(r'#define\s+(TYPE_\w+)\s+(\d+)',
+                         open(os.path.join(repo, 'include/constants/pokemon.h')).read()):
+        order[m.group(1)] = int(m.group(2))
+    cut = re.search(r'#define\s+IS_TYPE_PHYSICAL\(\w+\)\s*\(\w+\s*<\s*(TYPE_\w+)\)',
+                    open(os.path.join(repo, 'include/battle.h')).read())
+    split = order[cut.group(1)] if cut and cut.group(1) in order else 9
+
+    names, descs = {}, {}
+    for m in re.finditer(r'\[(MOVE_\w+)\]\s*=\s*_\("([^"]*)"\)',
+                         open(os.path.join(repo, 'src/data/text/move_names.h')).read()):
+        names[m.group(1)] = nice(m.group(2))
+    p = os.path.join(repo, 'src/data/text/move_descriptions.h')
+    if os.path.exists(p):
+        txt = open(p).read()
+        sym = {}
+        for m in re.finditer(r'static const u8 (s\w+Description)\[\]\s*=\s*_\(\s*((?:"[^"]*"\s*)+)\)', txt):
+            sym[m.group(1)] = ' '.join(re.findall(r'"([^"]*)"', m.group(2))).replace('\\n', ' ')
+        for m in re.finditer(r'\[(MOVE_\w+)\s*-\s*1\]\s*=\s*(s\w+Description)', txt):
+            descs[m.group(1)] = re.sub(r'\s+', ' ', sym.get(m.group(2), '')).strip()
+
+    # A flat array, not a dict: learnsets reference moves by index, which keeps
+    # ~13000 move references from being 13000 repeated name strings.
+    out = []
+    src = open(os.path.join(repo, 'src/data/battle_moves.h')).read()
+    for const, body in keyed_blocks(src, r'\[(MOVE_\w+)\]\s*=\s*\{'):
+        if const == 'MOVE_NONE':
+            continue
+        def num(field):
+            m = re.search(r'\.' + field + r'\s*=\s*(-?\d+)', body)
+            return int(m.group(1)) if m else 0
+        t = re.search(r'\.type\s*=\s*(TYPE_\w+)', body)
+        if not t:
+            continue
+        ti = order.get(t.group(1), 0)
+        ef = re.search(r'\.effect\s*=\s*EFFECT_(\w+)', body)
+        out.append([names.get(const, nice(const[5:])), t.group(1)[5:].title(),
+                    num('power'), num('accuracy'), num('pp'), num('priority'),
+                    1 if ti < split else 0, descs.get(const, ''),
+                    ef.group(1) if ef else '', const])
+    return out
+
