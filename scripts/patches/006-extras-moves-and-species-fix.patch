+def build_learnsets(repo, moves):
+    """What each species can actually learn: level-up moves with their level,
+    and the TMs and HMs it is compatible with. Moves are stored as indices into
+    the move table."""
+    idx = {row[9]: i for i, row in enumerate(moves)}          # MOVE_ const -> index
+
+    blocks = {}
+    for m in re.finditer(r'(\w+)\[\]\s*=\s*\{(.*?)\n\};',
+                         open(os.path.join(repo, 'src/data/pokemon/level_up_learnsets.h')).read(), re.S):
+        blocks[m.group(1)] = [[int(lv), idx['MOVE_' + mv]]
+                              for lv, mv in re.findall(r'LEVEL_UP_MOVE\(\s*(\d+)\s*,\s*MOVE_(\w+)\s*\)', m.group(2))
+                              if 'MOVE_' + mv in idx]
+    ptr = open(os.path.join(repo, 'src/data/pokemon/level_up_learnset_pointers.h')).read()
+    lv = {}
+    for const, sym in re.findall(r'\[(SPECIES_\w+)\]\s*=\s*(\w+)', ptr):
+        if const != 'SPECIES_NONE' and sym in blocks:
+            lv[species_name(const)] = blocks[sym]
+
+    # Emerald writes compatibility as ".TOXIC = TRUE"; FireRed as a bitfield of
+    # "TMHM(TM06_TOXIC)". Both name the machine, just differently.
+    by_field = {c[5:]: n for n, c in TMHM_CONST.items()}
+    tm = {}
+    src = open(os.path.join(repo, 'src/data/pokemon/tmhm_learnsets.h')).read()
+    for const, body in keyed_blocks(src, r'\[(SPECIES_\w+)\]\s*=\s*(?:TMHM_LEARNSET\(|\{)'):
+        if const == 'SPECIES_NONE':
+            continue
+        got = {by_field[f] for f in re.findall(r'\.(\w+)\s*=\s*TRUE', body) if f in by_field}
+        got |= {m.group(1) for m in re.finditer(r'TMHM\(((?:TM|HM)\d+)_\w+\)', body)}
+        if got:
+            tm[species_name(const)] = sorted(got)
+
+    # Two compactions, because this is by far the biggest table in the file:
+    # level-up moves flatten to [level, index, level, index, ...], and the ~23
+    # machines per species become a 58-bit mask in hex instead of 23 strings.
+    slot = {n: i for i, n in enumerate(sorted(TMHM_CONST,
+                                              key=lambda k: (k[0] == 'H', k)))}
+    out = {}
+    for sp in set(lv) | set(tm):
+        e = {}
+        if lv.get(sp):
+            e['l'] = [v for pair in lv[sp] for v in pair]
+        if tm.get(sp):
+            bits = 0
+            for n in tm[sp]:
+                if n in slot:
+                    bits |= 1 << slot[n]
+            e['t'] = '%015x' % bits
+        if e:
+            out[sp] = e
+    return out
+
